# PIXORA API — environment.
#
# COPY THIS, DO NOT EDIT IT IN PLACE, AND NEVER COMMIT THE COPY.
# Every value below is a NAME, not a secret. Nothing in this repository holds a
# credential, and the one test that walks the whole tree looking for one is
# phase4d-test.mjs §03.
#
# Classification: REQUIRED / OPTIONAL / SECRET / STAGING ONLY / DEV ONLY.
# See docs/132-deployment.md for what each one does to the running system.

# --- REQUIRED in production -------------------------------------------------
PIXORA_ENV=production                  # REQUIRED. Anything but "production" is a development posture.
PIXORA_HOST=127.0.0.1                  # REQUIRED. Bind to loopback and let the proxy reach it.
PIXORA_PORT=8787                       # REQUIRED.
PIXORA_DB=/var/lib/pixora/pixora.db    # REQUIRED. On a volume that is backed up.
PIXORA_ALLOWED_ORIGINS=https://admin.example.com   # REQUIRED if the host is not loopback.
PIXORA_TRUST_PROXY_HOPS=1              # REQUIRED behind a proxy: how many you control. 0 ignores X-Forwarded-For.

# --- OPTIONAL, with production-safe defaults --------------------------------
PIXORA_DB_CREATE=0                     # 0 in production: a missing volume must fail the boot.
PIXORA_SESSION_HOURS=12
PIXORA_AUTOMATION_TIMEOUT=120
PIXORA_SWEEP_INTERVAL=30
PIXORA_LOG=on                          # "off" silences the access log. Never logs bodies or tokens.

# --- Login rate limiting (Phase 4D §19) -------------------------------------
PIXORA_LOGIN_RATELIMIT=1               # Production refuses to start with this off.
PIXORA_LOGIN_WINDOW=900
PIXORA_LOGIN_ACCOUNT_FAILURES=5
PIXORA_LOGIN_ACCOUNT_LOCK=900
PIXORA_LOGIN_IP_FAILURES=50
PIXORA_LOGIN_IP_LOCK=300
PIXORA_LOGIN_MAX_LOCK=3600

# --- AI. OFF unless deliberately switched on --------------------------------
PIXORA_AI_ENABLED=0                    # The deployment-wide switch.
AI_AGENT_QA_READER_ENABLED=0           # The per-agent flag. Both must be on.
PIXORA_AI_PROVIDER=anthropic           # "fixture" is refused in production.
PIXORA_AI_MODEL=claude-sonnet-5
PIXORA_AI_TIMEOUT_MS=30000
PIXORA_AI_MAX_TOKENS=2048
ANTHROPIC_API_KEY=                     # SECRET. From the secret store at boot. Never in a file in this repo.

# --- Bootstrap. STAGING ONLY, and only for the first boot -------------------
# Set these once against an empty database to seed the first administrator,
# then REMOVE them. Production refuses to start while the password is set.
PIXORA_BOOTSTRAP_EMAIL=
PIXORA_BOOTSTRAP_PASSWORD=

    "film:clips": "node tools/build-hero-from-clips.js",
    "card": "node tools/build-share-card.js",
    "icon": "node tools/build-icon.js"
  },
  "devDependencies": {
    "ffmpeg-static": "^5.3.0",
    "playwright-core": "^1.62.1"
  }
}

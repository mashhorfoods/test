{
  "name": "pixora-site",
  "version": "1.0.0",
  "private": true,
  "description": "Pixora — a bilingual static site. Edit src/, run npm run build, upload the zip.",
  "scripts": {
    "build": "node build.js",
    "check": "node tools/validate.js && node tools/qa.js",
    "release": "npm run build && npm run check",
